{
  "name": "@axis/gui-shared",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "build": "vite build && npm run verify:dist",
    "notices:generate": "node scripts/generate-third-party-notices.mjs --write",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "solid-js": "^1.9.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
