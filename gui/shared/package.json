{
  "name": "@axis/gui-shared",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "build": "vite build && npm run verify:dist",
    "audit:deps": "node scripts/audit.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs --write",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "solid-js": "^1.9.19",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
